# For `docker compose`: copy to .env beside compose.yaml and chmod 600.
# For Portainer: set the same names under the stack's "Environment variables".
# Never commit .env.

# Required. The repository this runner serves.
REPO_URL=https://github.com/<owner>/<repo>

# Required. Personal access token the runner uses to register itself (and
# re-register after a restart). Fine-grained: this repo only, permission
# "Administration: Read and write". Classic: the `repo` scope.
ACCESS_TOKEN=

# Optional - these are the defaults.
RUNNER_NAME=lan-runner
LABELS=docker-builder
