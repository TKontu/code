# Copy to .env beside compose.yaml and chmod 600. Never commit .env.

# The repository this runner serves.
REPO_URL=https://github.com/<owner>/<repo>

# Personal access token the runner uses to register itself (and re-register
# after a restart). Fine-grained: this repo only, permission
# "Administration: Read and write". Classic: the `repo` scope.
ACCESS_TOKEN=

RUNNER_NAME=lan-runner
# Workflows select this runner with: runs-on: [self-hosted, docker-builder]
LABELS=docker-builder
